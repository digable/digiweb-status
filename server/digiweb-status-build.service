# Rebuilds the status page from the latest reports (see README).
[Unit]
Description=digiweb status page build

[Service]
Type=oneshot
User=status
Group=status
ExecStart=/usr/local/bin/digiweb-status-build
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/digiweb-status
