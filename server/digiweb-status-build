#!/usr/bin/env python3
"""digiweb-status-build: turn the machines' reports into the status page.

Runs on the status server as the `status` user: after every report (from digiweb-status-receive) and every
hour (digiweb-status-build.timer), so a machine that stops reporting turns red even if nothing
else happens. Writes one static HTML file; nginx serves it. Python 3 standard library only.

Settings: /etc/digiweb-status/site.json (see site.example.json).
"""
import html
import json
import os
import re
import time
from datetime import datetime

SITE = os.environ.get("DIGIWEB_STATUS_SITE", "/etc/digiweb-status/site.json")

try:
    from zoneinfo import ZoneInfo
except ImportError:            # very old Python: show the server's local time
    ZoneInfo = None

e = html.escape


# ---- formatting -------------------------------------------------------------------------------

def tz(site):
    if ZoneInfo:
        try:
            return ZoneInfo(site.get("timezone", "America/Chicago"))
        except Exception:
            pass
    return None


def when(ts, zone, date_only=False):
    if not ts:
        return "never"
    d = datetime.fromtimestamp(ts, zone)
    s = d.strftime("%a %b ") + str(d.day)
    if not date_only:
        s += ", " + d.strftime("%I:%M %p").lstrip("0")
    return s


def ago(ts, now):
    if not ts:
        return "never"
    s = max(0, now - ts)
    if s < 120:
        return "just now"
    if s < 7200:
        return "%d min ago" % (s // 60)
    if s < 172800:
        return "%d h ago" % (s // 3600)
    return "%d days ago" % (s // 86400)


def span(seconds):
    d = seconds // 86400
    if d >= 2:
        return "%d days" % d
    h = seconds // 3600
    return "%d h" % h if h else "%d min" % (seconds // 60)


def size(n):
    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if n < 1024 or unit == "TB":
            return ("%d %s" % (n, unit)) if unit == "B" else ("%.1f %s" % (n, unit)).replace(".0 ", " ")
        n /= 1024.0


def vparts(s):
    return [int(x) for x in re.findall(r"\d+", s or "")]


def at_least(have, want):
    w = vparts(want)
    return vparts(have)[:len(w)] >= w


# ---- judging a machine ----------------------------------------------------------------------

def judge(m, r, site, now):
    """Returns (state, issues): state is ok, watch or down; issues are short sentences."""
    issues = []
    if not r:
        return "down", ["%s has never reported." % m["name"]]
    if now - r.get("received_at", 0) > site.get("stale_hours", 48) * 3600:
        return "down", ["%s: last report %s" % (m["name"], ago(r.get("received_at"), now))]

    if r.get("updates_waiting"):
        issues.append("%d updates waiting" % r["updates_waiting"])
    if r.get("reboot_required"):
        issues.append("needs a reboot")
    if r.get("failed_units"):
        issues.append("failed: " + ", ".join(r["failed_units"]))
    for name, state in (r.get("services") or {}).items():
        if state != "active":
            issues.append("%s is %s" % (name, state))
    for j in r.get("jobs") or []:
        if j.get("result") not in (None, "success"):
            issues.append("%s ended with %s" % (j["label"], j["result"]))
    d = r.get("disk")
    if d and d["total"] and d["used"] / d["total"] * 100 >= site.get("disk_warn_percent", 85):
        issues.append("disk %d%% full" % (d["used"] / d["total"] * 100))
    b = r.get("backups")
    if b is not None:
        newest = b["files"][0]["time"] if b["files"] else 0
        if now - newest > site.get("backup_max_age_days", 8) * 86400:
            issues.append("no backup since " + (ago(newest, now) if newest else "ever"))
    for w in site.get("watch", []):
        rule = w.get("machines", {}).get(m["name"])
        if rule and not at_least(r.get(rule.get("field", "kernel")), rule["at_least"]):
            issues.append("%s: needs %s" % (w["item"], rule["at_least"]))
    sec = r.get("security")
    if sec:
        if sec.get("error"):
            issues.append("security scan: " + sec["error"])
        if sec.get("fixes_waiting"):
            n = len(sec["fixes_waiting"])
            issues.append("%d security fix%s waiting (%s)" % (n, "" if n == 1 else "es", ", ".join(sec["fixes_waiting"][:4])
                                                             + (", ..." if len(sec["fixes_waiting"]) > 4 else "")))
        if sec.get("urgent_count"):
            issues.append("%d urgent security problem%s with no fix yet" % (sec["urgent_count"], "" if sec["urgent_count"] == 1 else "s"))
    return ("watch" if issues else "ok"), issues


# ---- the page --------------------------------------------------------------------------------

