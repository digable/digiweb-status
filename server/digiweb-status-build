def dot(kind):
    return '<span class="dot %s"></span>' % kind


def row(label, value, note="", kind=None, bar=None):
    v = (dot(kind) if kind else "") + value
    if bar is not None:
        v += '<div class="bar"><i style="width:%d%%"></i></div>' % max(0, min(100, bar))
    if note:
        v += "<small>%s</small>" % note
    return "<dt>%s</dt><dd>%s</dd>" % (e(label), v)


def card(m, r, state, issues, site, zone, now):
    head = ('<div class="card-head"><div><div class="name">%s</div><div class="os">%s</div></div>'
            '<span class="badge %s pixel">%s</span></div>') % (
        e(m["name"]), e(" · ".join(x for x in [m.get("label"), r.get("os") if r else None,
                                                     "(%s)" % r["arch"] if r and r.get("arch") else None,
                                                     m.get("address")] if x)),
        state, {"ok": "ok", "watch": "watch", "down": "down"}[state])
    if not r:
        return '<section class="card">%s<div class="reported">no report yet</div></section>' % head

    rows = []
    up = r.get("last_upgrade")
    if up:
        t = up.get("start_ts")         # the reporting machine converted its own local time
        note = "%d upgraded" % up["upgraded"] + (", %d new" % up["installed"] if up["installed"] else "")
        rows.append(row("Last update", e(when(t, zone)), e(note), "bad" if up.get("error") else "ok"))
    else:
        rows.append(row("Last update", "none recorded"))
    waiting = r.get("updates_waiting")
    rows.append(row("Updates waiting", "?" if waiting is None else e(str(waiting)), kind="warn" if waiting else None))

    kernel_note, kernel_kind = "", None
    for w in site.get("watch", []):
        rule = w.get("machines", {}).get(m["name"])
        if rule:
            ok = at_least(r.get(rule.get("field", "kernel")), rule["at_least"])
            kernel_note = "%s %s" % (e(w["item"].split(" (")[0]), "fixed" if ok else "fix pending (" + e(rule["at_least"]) + ")")
            kernel_kind = None if ok else "warn"
    kv = r.get("kernel", "?")
    if r.get("kernel_upstream") and r["kernel_upstream"] not in kv:
        kv += " (%s)" % r["kernel_upstream"]
    rows.append(row("Kernel", e(kv), kernel_note, kernel_kind))
    sec = r.get("security")
    if sec:
        if sec.get("error"):
            rows.append(row("Security", "scan failed", e(sec["error"]), "warn"))
        else:
            waiting = len(sec.get("fixes_waiting") or [])
            notes = []
            if sec.get("urgent_count"):
                notes.append("%d urgent open" % sec["urgent_count"])
            if sec.get("new_count"):
                notes.append("%d new" % sec["new_count"])
            if sec.get("esm_only"):
                notes.append("%d more with Ubuntu Pro" % len(sec["esm_only"]))
            if sec.get("open_total") is not None and not notes:
                notes.append("%d known, none urgent" % sec["open_total"])
            rows.append(row("Security", "%d fix%s waiting" % (waiting, "" if waiting == 1 else "es"), e(" \u00b7 ".join(notes)),
                            "warn" if waiting or sec.get("urgent_count") else "ok"))
    rows.append(row("Reboot pending", "yes" if r.get("reboot_required") else "no", kind="warn" if r.get("reboot_required") else None))
    if r.get("booted_at"):
        rows.append(row("Up since", e(when(r["booted_at"], zone)), e(span(now - r["booted_at"]))))

    b = r.get("backups")
    extra = []
    if b is not None:
        if b["files"]:
            f = b["files"][0]
            kept = "%d kept" % len(b["files"]) + (" of %s" % b["keep"] if b.get("keep") else "")
            old = now - f["time"] > site.get("backup_max_age_days", 8) * 86400
            extra.append(row("Last backup", e(when(f["time"], zone)), e("%s · %s" % (size(f["size"]), kept)), "warn" if old else "ok"))
        else:
            extra.append(row("Last backup", "none", kind="warn"))
    d = r.get("disk")
    if d and d["total"]:
        pct = d["used"] / d["total"] * 100
        extra.append(row("Disk", "%d%% of %s" % (pct, size(d["total"])), bar=pct,
                         kind="warn" if pct >= site.get("disk_warn_percent", 85) else None))
    mem = r.get("memory")
    if mem and mem["total"]:
        pct = mem["used"] / mem["total"] * 100
        extra.append(row("Memory", "%d%% of %s" % (pct, size(mem["total"])), bar=pct))
    if r.get("temperature") is not None:
        extra.append(row("Temperature", "%s &deg;C" % e(str(r["temperature"]))))
    if r.get("failed_units"):
        extra.append(row("Failed", e(", ".join(r["failed_units"])), kind="bad"))

    svc = ""
    if r.get("services"):
        svc = '<div class="services">' + "".join(
            '<span class="svc">%s%s</span>' % (dot("ok" if s == "active" else "bad"), e(n))
            for n, s in r["services"].items()) + "</div>"

    body = "".join(rows) + ('<div class="sep"></div>' + "".join(extra) if extra else "")
    return '<section class="card">%s<div class="reported">reported %s</div><dl class="rows">%s</dl>%s</section>' % (
        head, e(ago(r.get("received_at"), now)), body, svc)


def page(site, reports, now):
    zone = tz(site)
    cards, problems, jobs, watch_rows, backup_rows = [], [], [], [], []
    worst = "ok"
    for m in site["machines"]:
        r = reports.get(m["name"])
        state, issues = judge(m, r, site, now)
        if state == "down" or (state == "watch" and worst == "ok"):
            worst = state
        for i in issues:
            problems.append((state, e(i) if state == "down" else "<b>%s</b>: %s" % (e(m["name"]), e(i))))
        cards.append(card(m, r, state, issues, site, zone, now))
        for j in (r or {}).get("jobs") or []:
            res = j.get("result")
            # a service's result isn't kept across a reboot: that's not a problem, just unknown
            kind = "ok" if res == "success" else ("bad" if res else "none")
            text = "ok" if res == "success" else (res or ("running" if j.get("running") else
                                                           "ran; result not kept after a reboot" if j.get("last_run") else "hasn't run yet"))
            jobs.append((j.get("next_run") or 0, "<tr><td>%s</td><td>%s</td><td>%s</td><td>%s%s</td><td class=\"muted\">%s</td></tr>" % (
                e(j["label"]), e(m["name"]), e(when(j.get("last_run"), zone)), dot(kind), e(text),
                e(when(j.get("next_run"), zone)))))
        for f in ((r or {}).get("backups") or {}).get("files", []):
            backup_rows.append("<tr><td>%s</td><td>%s</td><td>%s</td><td class=\"muted\">%s</td></tr>" % (
                e(f["name"]), e(m["name"]), e(size(f["size"])), e(when(f["time"], zone))))

    for w in site.get("watch", []):
        cells = []
        for m in site["machines"]:
            rule = w.get("machines", {}).get(m["name"])
            r = reports.get(m["name"])
            if not rule:
                cells.append('<td class="muted">-</td>')
            elif not r:
                cells.append('<td class="muted">no report</td>')
            elif at_least(r.get(rule.get("field", "kernel")), rule["at_least"]):
                cells.append("<td>%sfixed</td>" % dot("ok"))
            else:
                cells.append("<td>%sneeds %s</td>" % (dot("warn"), e(rule["at_least"])))
        watch_rows.append("<tr><td>%s</td>%s</tr>" % (e(w["item"]), "".join(cells)))

    banner = ""
    if problems:
        bad = any(s == "down" for s, _ in problems)
        banner = '<div class="banner%s"><span class="pixel">%d to %s</span><ul>%s</ul></div>' % (
            " bad" if bad else "", len(problems), "fix" if bad else "watch",
            "".join("<li>%s</li>" % p for _, p in problems))
    else:
        banner = '<div class="banner" style="border-color:rgb(91 227 143 / .5);background:rgb(91 227 143 / .08)"><span class="pixel" style="color:var(--ok)">all good</span><p style="margin:0">Every machine reported, is up to date and has nothing pending.</p></div>'

    sec_rows = []
    for m in site["machines"]:
        sec = (reports.get(m["name"]) or {}).get("security")
        if not sec or sec.get("error"):
            continue
        link = sec.get("link", "")
        if not (isinstance(link, str) and link.startswith("https://")):
            link = ""                   # a tracker link, never javascript: or anything else a report makes up
        def cve(c):
            return '<a href="%s%s" rel="noreferrer">%s</a>' % (e(link), e(c), e(c)) if link else e(c)
        for pkg in sec.get("fixes_waiting") or []:
            sec_rows.append("<tr><td>%s</td><td>%s</td><td>%sfix waiting</td><td class=\"muted\">next Sunday's update installs it</td></tr>" % (
                e(m["name"]), e(pkg), dot("warn")))
        for u in sec.get("urgent") or []:
            sec_rows.append("<tr><td>%s</td><td>%s</td><td>%s%s</td><td class=\"muted\">%s, no fix yet</td></tr>" % (
                e(m["name"]), e(u["pkg"]), dot("bad" if "high" in u["notes"] else "warn"), cve(u["cve"]), e(u["notes"])))
        for n in sec.get("new") or []:
            sec_rows.append("<tr><td>%s</td><td>%s</td><td>%s%s</td><td class=\"muted\">new since the last report</td></tr>" % (
                e(m["name"]), e(", ".join(n["pkgs"])), dot("none"), cve(n["cve"])))
        if sec.get("esm_only"):
            sec_rows.append("<tr><td>%s</td><td>%s</td><td>%s%d with Ubuntu Pro</td><td class=\"muted\">fixes only available through Ubuntu Pro (free for personal use)</td></tr>" % (
                e(m["name"]), e(", ".join(sec["esm_only"][:6]) + (", ..." if len(sec["esm_only"]) > 6 else "")), dot("none"), len(sec["esm_only"])))

    jobs.sort(key=lambda x: x[0])
    sections = ""
    if jobs:
        sections += ('<h2>Scheduled jobs</h2><div class="tablewrap"><table><tr><th>job</th><th>machine</th>'
                     '<th>last run</th><th>result</th><th>next run</th></tr>%s</table></div>') % "".join(j for _, j in jobs)
    scanned = [m["name"] for m in site["machines"] if (reports.get(m["name"]) or {}).get("security")]
    if scanned:
        sections += ('<h2>Security</h2><div class="tablewrap"><table><tr><th>machine</th><th>package</th><th>issue</th>'
                     '<th>note</th></tr>%s</table></div>') % ("".join(sec_rows) or
                     '<tr><td colspan="4">%sNothing to act on: no fixes waiting, nothing urgent and nothing new on %s.</td></tr>' % (dot("ok"), e(", ".join(scanned))))
    if backup_rows:
        sections += ('<h2>Backups</h2><div class="tablewrap"><table><tr><th>file</th><th>machine</th><th>size</th>'
                     '<th>made</th></tr>%s</table></div>') % "".join(backup_rows)
    if watch_rows:
        sections += ('<h2>Watch list</h2><div class="tablewrap"><table><tr><th>item</th>%s</tr>%s</table></div>') % (
            "".join("<th>%s</th>" % e(m["name"]) for m in site["machines"]), "".join(watch_rows))

    title = {"ok": "all good", "watch": "watch", "down": "DOWN"}[worst]
    return """<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="300">
<title>digiweb status: %s</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Press+Start+2P&family=Space+Grotesk:wght@500;700&display=swap">
<style>%s</style></head><body><div class="wrap">
<header><div><h1>digiweb<span>.</span>status</h1><div class="sub">your machines: updates, kernels, backups and services</div></div>
<div class="stamp">page built <b>%s</b><br>refreshes every 5 minutes</div></header>
%s<div class="grid">%s</div>%s
<footer>Private: only reachable from your home network and Tailscale, with a login. Machines report every morning and a
few minutes after a reboot; one that hasn't reported in %d hours turns red.</footer>
</div></body></html>
""" % (title, CSS, e(when(now, zone)), banner, "".join(cards), sections, site.get("stale_hours", 48))


def main():
    with open(SITE, encoding="utf-8") as f:
        site = json.load(f)
    folder = site.get("reports_dir", "/var/lib/digiweb-status/reports")
    reports = {}
    for m in site["machines"]:
        try:
            with open(os.path.join(folder, m["name"] + ".json"), encoding="utf-8") as f:
                reports[m["name"]] = json.load(f)
        except (OSError, ValueError):
            pass
    out = site.get("output", "/var/www/digiweb-status/index.html")
    os.makedirs(os.path.dirname(out), exist_ok=True)
    tmp = out + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(page(site, reports, int(time.time())))
    os.replace(tmp, out)


if __name__ == "__main__":
    main()
