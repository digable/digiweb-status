#!/usr/bin/env python3
"""digiweb-report: gather this machine's status and send it to the status page on the status server.

Runs as root from digiweb-report.timer (every morning and a few minutes after boot). Reads only:
os-release, uname, /proc, the apt log, `apt-get -s`, systemctl and the backup folder (if any).
It never reads secrets, and the report holds none.

    digiweb-report            gather and send
    digiweb-report --print    gather and print the report (nothing is sent)

Settings: /etc/digiweb-status/report.json (see report.example.json). Python 3 standard library only.
"""
import glob
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import time

CONFIG = os.environ.get("DIGIWEB_REPORT_CONFIG", "/etc/digiweb-status/report.json")
REPORT_VERSION = 1


def run(cmd, timeout=60, stdin=None):
    """Runs a command; returns (exit code, stdout). Never raises."""
    try:
        p = subprocess.run(cmd, input=stdin, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except (OSError, subprocess.TimeoutExpired):
        return -1, ""


def read(path, default=""):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return default


# ---- the system ---------------------------------------------------------------------------------

def os_name():
    m = re.search(r'^PRETTY_NAME="?([^"\n]*)"?', read("/etc/os-release"), re.M)
    return m.group(1) if m else platform.system()


def kernel_upstream():
    """The upstream kernel version. Debian's `uname -r` (6.1.0-54) hides it; `uname -v` has it."""
    m = re.search(r"Debian (\d+\.\d+\.\d+)", platform.version())
    if m:
        return m.group(1)
    m = re.match(r"(\d+\.\d+\.\d+)", platform.release())
    return m.group(1) if m else platform.release()


def boot_time():
    try:
        return round(time.time() - float(read("/proc/uptime").split()[0]))
    except (ValueError, IndexError):
        return None


def kernel_key(name):
    """Comparable version of a kernel name: 7.0.0-42-generic -> (7, 0, 0, 42), 6.18.50+rpt-rpi-v8 -> (6, 18, 50, 0)."""
    m = re.match(r"(\d+)\.(\d+)\.(\d+)(?:-(\d+))?", name)
    return tuple(int(x or 0) for x in m.groups()) if m else None


def newer_kernel_installed(booted=None):
    """True if a kernel newer than the running one is installed: a reboot is needed even where the
    system doesn't flag it (Raspberry Pi OS doesn't always). Older kernels kept as a fallback, and
    other flavours of the same version (the Pi has two), don't count."""
    running = kernel_key(platform.release())
    if running is None:
        return False
    for d in glob.glob("/lib/modules/*"):
        key = kernel_key(os.path.basename(d))
        # modules.dep is only there while that kernel is installed (not in leftover folders)
        if key and key > running and os.path.exists(os.path.join(d, "modules.dep")):
            return True
    return False


def upgradable():
    """Names of the packages a full upgrade would install now (from the package lists apt last
    downloaded), or None if apt can't say."""
    code, out = run(["apt-get", "-s", "-o", "Debug::NoLocking=1", "dist-upgrade"], timeout=120)
    if code != 0:
        return None
    return {line.split()[1].split(":")[0] for line in out.splitlines() if line.startswith("Inst ")}


def updates_waiting():
    names = upgradable()
    return None if names is None else len(names)


def last_apt_upgrade():
    """The most recent upgrade in apt's history: when, the command, packages upgraded/installed."""
    text = read("/var/log/apt/history.log")
    last = None
    for block in text.split("\n\n"):
        fields = {}
        for line in block.strip().splitlines():
            key, _, value = line.partition(": ")
            fields[key] = value
        if "upgrade" in fields.get("Commandline", ""):
            last = fields
    if not last:
        return None

    def count(value):
        return len(re.findall(r"\),?", value)) if value else 0

    start = last.get("Start-Date", "").replace("  ", " ")
    try:    # apt logs this machine's local time; send a timestamp so the status server needn't guess the zone
        start_ts = int(time.mktime(time.strptime(start, "%Y-%m-%d %H:%M:%S")))
    except ValueError:
        start_ts = None
    return {
        "start": start,
        "start_ts": start_ts,
        "end": last.get("End-Date", "").replace("  ", " "),
        "command": last.get("Commandline", ""),
        "upgraded": count(last.get("Upgrade")),
        "installed": count(last.get("Install")),
        "error": bool(last.get("Error")),
    }


def systemd_props(unit, props):
    code, out = run(["systemctl", "show", unit, "--timestamp=unix", "-p", ",".join(props)])
    values = {}
    for line in out.splitlines():
        key, _, value = line.partition("=")
        values[key] = value
    return values


def unix_or_none(value):
    """A systemd time as seconds. Newer systemd honors --timestamp=unix ("@1793527254"); systemd 252
    (Debian 12) still prints timer times as dates ("Sun 2026-11-01 04:00:54 CST"), which GNU date
    reads, zone abbreviation included. Empty or "n/a" means never."""
    value = (value or "").strip()
    m = re.match(r"@(\d+)", value)
    if m:
        return int(m.group(1))
    if not value or value == "n/a" or value == "0":
        return None
    code, out = run(["date", "-d", value, "+%s"], timeout=10)
    return int(out.strip()) if code == 0 and out.strip().isdigit() else None


def job_status(job):
    """A scheduled job: when its timer last fired and fires next, and how its service ended.
    A service's result is forgotten after a reboot; the timer's last run is not (Persistent=true)."""
    t = systemd_props(job["timer"], ["LastTriggerUSec", "NextElapseUSecRealtime"])
    s = systemd_props(job["service"], ["Result", "ExecMainStatus", "ExecMainExitTimestamp", "ActiveState"])
    ended = unix_or_none(s.get("ExecMainExitTimestamp"))
    return {
        "label": job.get("label", job["service"]),
        "last_run": unix_or_none(t.get("LastTriggerUSec")),
        "next_run": unix_or_none(t.get("NextElapseUSecRealtime")),
        "ended": ended,
        "result": s.get("Result") if ended else None,      # None: unknown (not run since boot)
        "exit_status": s.get("ExecMainStatus") if ended else None,
        "running": s.get("ActiveState") == "activating",
    }


def services(names):
    out = {}
    for name in names:
        code, state = run(["systemctl", "is-active", name])
        out[name] = state.strip() or "unknown"
    return out


def failed_units():
    code, out = run(["systemctl", "list-units", "--state=failed", "--no-legend", "--plain"])
    return [line.split()[0] for line in out.splitlines() if line.strip()]


def disk():
    u = shutil.disk_usage("/")
    return {"total": u.total, "used": u.used}


def memory():
    info = {}
    for line in read("/proc/meminfo").splitlines():
        key, _, value = line.partition(":")
        if value.strip().endswith("kB"):
            info[key] = int(value.split()[0]) * 1024
    if "MemTotal" not in info:
        return None
    return {"total": info["MemTotal"], "used": info["MemTotal"] - info.get("MemAvailable", 0)}


def temperature():
    temps = []
    for path in glob.glob("/sys/class/thermal/thermal_zone*/temp"):
        try:
            temps.append(int(read(path).strip()) / 1000)
        except ValueError:
            pass
    return round(max(temps), 1) if temps else None


def backups(cfg):
    if not cfg:
        return None
    files = []
    for path in glob.glob(os.path.join(cfg["dir"], cfg.get("pattern", "*.tar.gz"))):
        try:
            st = os.stat(path)
            files.append({"name": os.path.basename(path), "size": st.st_size, "time": int(st.st_mtime)})
        except OSError:
            pass
    files.sort(key=lambda f: f["time"], reverse=True)
    return {"keep": cfg.get("keep"), "files": files}


# ---- security --------------------------------------------------------------------------------
# Only packages installed on this machine are checked, against the distribution's own security data:
#   debsecan (Debian, Raspberry Pi OS)  install with: sudo apt install --no-install-recommends debsecan
#                                       (without the flag it also installs a mail server)
#   pro security-status (Ubuntu, built in)
# Sends: fixes waiting (security updates released but not installed), urgent open problems (high
# urgency or remotely exploitable, no fix yet), and CVEs new since the last report.

STATE_DIR = "/var/lib/digiweb-report"
NOISE_PACKAGES = {"linux-libc-dev"}     # kernel headers: carry every kernel CVE but never run
MAX_LIST = 20


def codename():
    m = re.search(r"^VERSION_CODENAME=(\S+)", read("/etc/os-release"), re.M)
    return m.group(1).strip('"') if m else None


def new_since_last(ids_by_pkg):
    """CVE ids not seen in the last report (kept in STATE_DIR). The first run only records the
    list, so a fresh install doesn't call thousands of old CVEs new."""
    path = os.path.join(STATE_DIR, "cves.txt")
    current = set(ids_by_pkg)
    try:
        with open(path, encoding="utf-8") as f:
            seen = set(f.read().split())
        first = False
    except OSError:
        seen, first = set(), True
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(path + ".tmp", "w", encoding="utf-8") as f:
            f.write("\n".join(sorted(current)))
        os.replace(path + ".tmp", path)
    except OSError:
        pass
    if first:
        return None
    return sorted(current - seen)


def security_debsecan():
    suite = codename()
    if not suite:
        return {"tool": "debsecan", "error": "unknown release"}
    code, out = run(["debsecan", "--suite", suite, "--format", "summary"], timeout=300)
    if code != 0 or not out.strip():
        return {"tool": "debsecan", "error": "debsecan failed (exit %s)" % code}
    ids_by_pkg, urgent = {}, []
    for line in out.splitlines():
        m = re.match(r"(CVE-\d+-\d+|TEMP-\S+)\s+(\S+)(?:\s+\((.*)\))?", line.strip())
        if not m:
            continue
        cve, pkg, notes = m.group(1), m.group(2), (m.group(3) or "").lower()
        ids_by_pkg.setdefault(cve, set()).add(pkg)
        if pkg not in NOISE_PACKAGES and ("high urgency" in notes or "remotely exploitable" in notes):
            urgent.append({"cve": cve, "pkg": pkg, "notes": notes})
    # debsecan's --only-fixed means "fixed somewhere in Debian" (unstable counts), so a fix is only
    # waiting when apt can actually install a newer version of that package here
    code, fixed = run(["debsecan", "--suite", suite, "--format", "packages", "--only-fixed"], timeout=300)
    can_install = upgradable() or set()
    fixes = sorted(set(fixed.split()) & can_install) if code == 0 else []
    # "new" leaves out CVEs that only touch the kernel headers (a handful every day, never run)
    counted = {c: p for c, p in ids_by_pkg.items() if p - NOISE_PACKAGES}
    new = new_since_last(counted)
    return {
        "tool": "debsecan",
        "link": "https://security-tracker.debian.org/tracker/",
        "open_total": len(ids_by_pkg),
        "fixes_waiting": fixes,
        "urgent": urgent[:MAX_LIST],
        "urgent_count": len(urgent),
        "new": None if new is None else [{"cve": c, "pkgs": sorted(counted[c])} for c in new[:MAX_LIST]],
        "new_count": None if new is None else len(new),
    }


def security_pro():
    code, out = run(["pro", "security-status", "--format", "json"], timeout=120)
    try:
        data = json.loads(out)
    except ValueError:
        return {"tool": "pro", "error": "pro security-status failed (exit %s)" % code}
    fixes, esm = set(), set()
    for p in data.get("packages", []):
        service, status = p.get("service_name", ""), p.get("status", "")
        if status == "upgrade_available" and service in ("standard-security", "esm-infra", "esm-apps"):
            fixes.add(p.get("package", "?"))
        elif status in ("pending_attach", "pending_enable"):
            esm.add(p.get("package", "?"))
    return {
        "tool": "pro",
        "link": "https://ubuntu.com/security/",
        "fixes_waiting": sorted(fixes),
        "esm_only": sorted(esm),       # fixes that need Ubuntu Pro (free for personal use) to install
    }


def security(cfg):
    tool = (cfg or {}).get("tool")
    if not tool:
        return None
    try:
        return security_debsecan() if tool == "debsecan" else security_pro() if tool == "pro" else None
    except Exception as exc:      # a scanner problem must never stop the report
        return {"tool": tool, "error": str(exc)[:200]}


# ---- the report -------------------------------------------------------------------------------

def gather(cfg):
    booted = boot_time()
    return {
        "version": REPORT_VERSION,
        "machine": cfg["machine"],
        "reported_at": int(time.time()),
        "os": os_name(),
        "arch": platform.machine(),
        "kernel": platform.release(),
        "kernel_upstream": kernel_upstream(),
        "booted_at": booted,
        "reboot_required": os.path.exists("/var/run/reboot-required") or newer_kernel_installed(booted),
        "updates_waiting": updates_waiting(),
        "last_upgrade": last_apt_upgrade(),
        "jobs": [job_status(j) for j in cfg.get("jobs", [])],
        "services": services(cfg.get("services", [])),
        "failed_units": failed_units(),
        "disk": disk(),
        "memory": memory(),
        "temperature": temperature(),
        "backups": backups(cfg.get("backups")),
        "security": security(cfg.get("security")),
    }


def send(cfg, report):
    """Hands the report to the status server. Over SSH the key can only run the receiver, and the receiver
    files it under the machine name tied to that key, so one machine can't pose as another."""
    data = json.dumps(report)
    s = cfg["send"]
    if s.get("local"):
        cmd = ["runuser", "-u", s.get("user", "status"), "--", "/usr/local/bin/digiweb-status-receive", cfg["machine"]]
    else:
        cmd = ["ssh", "-i", s["key"], "-o", "BatchMode=yes", "-o", "ConnectTimeout=15",
               "-o", "StrictHostKeyChecking=yes", "-o", "UserKnownHostsFile=" + s["known_hosts"],
               "%s@%s" % (s.get("user", "status"), s["host"])]
    code, out = run(cmd, timeout=90, stdin=data)
    if code != 0:
        sys.exit("digiweb-report: sending failed (exit %s)" % code)
    print(out.strip() or "sent")


def main():
    with open(CONFIG, encoding="utf-8") as f:
        cfg = json.load(f)
    report = gather(cfg)
    if "--print" in sys.argv[1:]:
        print(json.dumps(report, indent=2))
        return
    send(cfg, report)


if __name__ == "__main__":
    main()
